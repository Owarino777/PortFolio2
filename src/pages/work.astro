---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";

import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";
import ProjectGallery from "../components/ProjectGallery.astro";

const projects = (await getCollection("work")).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
	title="Mes projets"
	description="Découvrez mes projets les plus récents ci-dessous pour avoir une idée de mon expérience passée."
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Mes projets"
				tagline="Découvrez mes projets les plus récents ci-dessous pour avoir une idée de mon expérience passée."
				align="start"
			/>
			<ProjectGallery projects={projects} />
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
