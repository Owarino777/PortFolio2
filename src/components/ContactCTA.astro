---
import CallToAction from "./CallToAction.astro";
import Icon from "./Icon.astro";
---

<aside id="contact">
	<div class="intro">
		<h2>Envie de travailler avec moi ?</h2>
		<p>Parlez-moi de votre projet ou posez-moi une question.</p>
		<CallToAction href="mailto:malikcheikhpro14@gmail.com">
			M'écrire par email
			<Icon icon="paper-plane-tilt" size="1.2em" />
		</CallToAction>
	</div>

	<form id="contact-form" hidden>
		<div class="fields">
			<div class="field">
				<label for="contact-name">Nom</label>
				<input id="contact-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="100" required />
			</div>
			<div class="field">
				<label for="contact-email">Email</label>
				<input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required />
			</div>
		</div>
		<div class="field">
			<label for="contact-message">Message</label>
			<textarea id="contact-message" name="message" rows="5" minlength="10" maxlength="3000" required></textarea>
		</div>
		<div class="trap" aria-hidden="true">
			<label for="contact-website">Site web</label>
			<input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
		</div>
		<button type="submit">Envoyer le message</button>
		<p class="status" role="status" aria-live="polite"></p>
		<p class="privacy">Votre nom, votre email et votre message sont transmis via Formspree pour me permettre de vous répondre.</p>
	</form>
</aside>

<script>
	import { getApiBaseUrl, sendContact } from '../lib/portfolioApi';

	const form = document.querySelector<HTMLFormElement>('#contact-form');
	if (form && getApiBaseUrl()) {
		form.hidden = false;
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!form.reportValidity()) return;
			const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			const status = form.querySelector<HTMLElement>('[role="status"]');
			const data = new FormData(form);
			if (!button || !status) return;
			button.disabled = true;
			status.textContent = 'Envoi en cours…';
			try {
				await sendContact({
					name: String(data.get('name') ?? '').trim(),
					email: String(data.get('email') ?? '').trim(),
					message: String(data.get('message') ?? '').trim(),
					website: String(data.get('website') ?? ''),
				});
				status.textContent = 'Message envoyé. Merci, je vous répondrai dès que possible.';
				form.reset();
			} catch {
				status.textContent = "L'envoi a échoué. Utilisez le lien email ci-contre pour me contacter.";
			} finally {
				button.disabled = false;
			}
		});
	}
</script>

<style>
	aside {
		display: grid;
		gap: 2.5rem;
		border-top: 1px solid var(--gray-800);
		border-bottom: 1px solid var(--gray-800);
		padding: 4rem 1.5rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	.intro {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
	}

	h2 {
		font-size: var(--text-xl);
		max-width: 18ch;
	}

	.intro p, .privacy {
		color: var(--gray-400);
	}

	.intro :global(a) {
		margin-top: 1rem;
	}

	form {
		display: grid;
		gap: 1rem;
		width: 100%;
		max-width: 38rem;
	}

	form[hidden] {
		display: none;
	}

	.fields {
		display: grid;
		gap: 1rem;
	}

	.field {
		display: grid;
		gap: 0.35rem;
	}

	label {
		font-weight: 700;
	}

	input, textarea {
		width: 100%;
		padding: 0.8rem 1rem;
		border: 1px solid var(--gray-600);
		border-radius: 0.65rem;
		background: var(--gray-999);
		color: var(--gray-100);
		font: inherit;
	}

	input:focus-visible, textarea:focus-visible, button:focus-visible {
		outline: 3px solid var(--accent-regular);
		outline-offset: 3px;
	}

	textarea {
		resize: vertical;
	}

	.trap {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}

	button {
		justify-self: start;
		border: 0;
		border-radius: 999rem;
		padding: 0.85rem 1.5rem;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}

	button:disabled {
		opacity: 0.6;
		cursor: wait;
	}

	.status {
		min-height: 1.5em;
	}

	.privacy {
		font-size: var(--text-sm);
	}

	@media (min-width: 50em) {
		aside {
			grid-template-columns: minmax(16rem, 1fr) minmax(20rem, 38rem);
			justify-content: space-between;
			gap: 4rem;
			padding: 5rem max(5vw, 2rem);
		}
		h2 {
			font-size: var(--text-3xl);
		}
		.fields {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
